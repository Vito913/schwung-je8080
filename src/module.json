{
    "id": "je8080",
    "name": "JE-8080 (experimental)",
    "abbrev": "J8",
    "version": "0.1.0",
    "description": "EXPERIMENTAL Roland JP-8080 rack emulator built on the JE-8086 module. Boots JP-8080 firmware v1.04 and takes MIDI, but the rack-only hardware is not emulated yet, so the output is muted. For development, not for playing.",
    "author": "dsp56300/gearmulator, JE-8086 port by charlesvestal (JE-8080: vito913)",
    "dsp": "dsp.so",
    "api_version": 2,
    "standalone": false,
    "assets": [
        {
            "path": "roms",
            "label": "ROMs",
            "extensions": [
                ".bin",
                ".mid"
            ],
            "description": "Requires the JP-8080 firmware as one 917,504-byte .bin flash image (v1.04 tested). A 14-file JP-8080 .mid update dump (79,373 bytes each) should also load (untested). A JP-8000 ROM will NOT load here: use JE-8086 for that.",
            "hint": "Runs the same three-stage pipeline as JE-8086 and shares its lock: only one JE-8080 or JE-8086 can run at a time.",
            "hint_url": "https://github.com/vito913/schwung-je8080",
            "hint_url_label": "Read more",
            "files": [
                {
                    "filename": "jp8080.bin",
                    "label": "JP-8080 firmware (.bin)",
                    "size": 917504,
                    "required": true
                }
            ]
        },
        {
            "path": "banks",
            "label": "Banks",
            "extensions": [
                ".syx",
                ".j8k",
                ".mid",
                ".MID",
                ".pat",
                ".pfm"
            ],
            "description": "Extra patch and performance banks. Nested folders are scanned, and each file becomes a bank in the browser beside Factory A/B.",
            "optional": true,
            "allowFolders": true
        }
    ],
    "capabilities": {
        "audio_out": true,
        "audio_in": false,
        "midi_in": true,
        "midi_out": false,
        "default_forward_channel": 3,
        "chainable": true,
        "component_type": "sound_generator",
        "forks_processes": true
    },
    "_chain_params_note": "Fallback only. The live contract (169 params + bank enums) is served by get_param('chain_params') in dsp/jp8000_plugin.cpp, generated from tools/gen_params.py into dsp/jp8000_params.h (shared with JE-8086). Keys and ranges here mirror the patch_main knobs.",
    "chain_params": [
        {
            "key": "mode",
            "name": "Mode",
            "type": "enum",
            "options": [
                "Patch",
                "Performance"
            ],
            "default": 0
        },
        {
            "key": "part",
            "name": "Edit Part",
            "short_name": "Part",
            "type": "enum",
            "options": [
                "Upper",
                "Lower",
                "Both"
            ],
            "default": 0
        },
        {
            "key": "cutoff",
            "name": "Cutoff",
            "short_name": "Cut",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 127
        },
        {
            "key": "resonance",
            "name": "Resonance",
            "short_name": "Res",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 0
        },
        {
            "key": "filter_env_depth",
            "name": "Filter Env",
            "short_name": "Env",
            "type": "int",
            "min": -64,
            "max": 63,
            "default": 0
        },
        {
            "key": "amp_attack",
            "name": "Amp Attack",
            "short_name": "Atk",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 0
        },
        {
            "key": "amp_decay",
            "name": "Amp Decay",
            "short_name": "Dcy",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 64
        },
        {
            "key": "amp_sustain",
            "name": "Amp Sustain",
            "short_name": "Sus",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 127
        },
        {
            "key": "amp_release",
            "name": "Amp Release",
            "short_name": "Rel",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 0
        },
        {
            "key": "delay_level",
            "name": "Delay Level",
            "short_name": "Delay",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 0
        },
        {
            "key": "amp_level",
            "name": "Amp Level",
            "short_name": "Level",
            "type": "int",
            "min": 0,
            "max": 127,
            "default": 127
        }
    ]
}
